{
  "name": "activity-organizer",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check extension.js && node --check prefs.js && glib-compile-schemas --strict --dry-run schemas",
    "check:compat": "node tests/shell-compat.js",
    "showcase": "node tests/compose-showcase.js && rsvg-convert -o docs/images/showcase.png docs/images/showcase.svg",
    "pack": "mkdir -p dist && gnome-extensions pack --force --extra-source=lib --extra-source=LICENSE --out-dir=dist ."
  }
}
